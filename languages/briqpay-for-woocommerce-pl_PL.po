msgstr "Firma – tylko metody płatności"

#: includes/class-gateway.php:149 includes/class-hosted-payment-page.php:101
msgid "Business - Full Checkout"
msgstr "Firma – pełna kasa"

#: includes/class-gateway.php:153
msgid "Hosted page title"
msgstr "Tytuł strony płatności"

#: includes/class-gateway.php:155
msgid ""
"Short text shown to the customer beneath your logo. Between 3 and 256 "
"characters; leave empty to omit."
msgstr "Krótki tekst wyświetlany klientowi pod Twoim logo. Od 3 do 256 znaków; pozostaw puste, aby go pominąć."

#: includes/class-gateway.php:160
msgid "Hosted page logo URL"
msgstr "Adres URL logo strony płatności"

#: includes/class-gateway.php:162
msgid ""
"Absolute URL to a PNG, JPG, JPEG or SVG image (max 512 characters). Leave "
"empty to omit."
msgstr "Bezwzględny adres URL do obrazu PNG, JPG, JPEG lub SVG (maksymalnie 512 znaków). Pozostaw puste, aby go pominąć."

#: includes/class-gateway.php:167
msgid "Show cart on hosted page"
msgstr "Pokaż koszyk na stronie płatności"

#: includes/class-gateway.php:168
msgid "Display the order lines above the payment section"
msgstr "Wyświetl pozycje zamówienia powyżej sekcji płatności"

#: includes/class-gateway.php:173
msgid "Logging"
msgstr "Rejestrowanie"

#: includes/class-gateway.php:174
msgid "Log Briqpay events"
msgstr "Rejestruj zdarzenia Briqpay"

#: includes/class-gateway.php:176
msgid "Log Briqpay events, such as API requests."
msgstr "Rejestruj zdarzenia Briqpay, na przykład żądania do API."

#: includes/class-gateway.php:180
msgid "Verbose Logging"
msgstr "Rejestrowanie szczegółowe"

#: includes/class-gateway.php:181
msgid "Enable verbose debug logs"
msgstr "Włącz szczegółowe dzienniki diagnostyczne"

#: includes/class-gateway.php:183
msgid ""
"Include detailed trace messages like availability checks and cart processing."
msgstr "Dołącz szczegółowe komunikaty śledzenia, takie jak sprawdzanie dostępności i przetwarzanie koszyka."

#: includes/class-gateway.php:187
msgid "Migration / legacy compatibility"
msgstr "Migracja / zgodność ze starszą wersją"

#: includes/class-gateway.php:189
msgid ""
"Options for stores migrating from the previous Briqpay for WooCommerce "
"plugin."
msgstr "Opcje dla sklepów migrujących z poprzedniej wtyczki Briqpay for WooCommerce."

#: includes/class-gateway.php:192
msgid "Legacy B2B order meta mapping"
msgstr "Stare mapowanie metadanych zamówień B2B"

#: includes/class-gateway.php:193
msgid "Also store B2B order data using the previous plugin's meta keys"
msgstr "Zapisuj dane zamówień B2B również w kluczach meta poprzedniej wtyczki"

#: includes/class-gateway.php:195
msgid ""
"For stores migrating from the previous Briqpay plugin. B2B orders "
"additionally store the organisation number in <code>_billing_org_nr</code> "
"and the shipping email in <code>_shipping_email</code>, so existing ERP "
"exports and integrations keep working. Current meta keys are always written "
"as well."
msgstr "Dla sklepów migrujących z poprzedniej wtyczki Briqpay. Zamówienia B2B zapisują dodatkowo NIP w <code>_billing_org_nr</code> oraz adres e-mail dostawy w <code>_shipping_email</code>, aby istniejące eksporty do ERP i integracje nadal działały. Aktualne klucze meta są zawsze zapisywane również."

#: includes/class-gateway.php:373
msgid "Please complete your payment using the Briqpay checkout."
msgstr "Dokończ płatność w kasie Briqpay."

#: includes/class-gateway.php:459
msgid ""
"Briqpay: the hosted page logo URL must be an absolute URL ending "
"in .png, .jpg, .jpeg or .svg, and at most 512 characters."
msgstr "Briqpay: adres URL logo strony płatności musi być bezwzględnym adresem URL kończącym się na .png, .jpg, .jpeg lub .svg i mieć maksymalnie 512 znaków."

