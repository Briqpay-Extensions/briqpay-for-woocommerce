msgstr "Aktivera/inaktivera"

#: includes/class-gateway.php:81
msgid "Enable Briqpay"
msgstr "Aktivera Briqpay"

#: includes/class-gateway.php:85
msgid "Merchant ID (MID)"
msgstr "Handlar-ID (MID)"

#: includes/class-gateway.php:87 includes/class-gateway.php:92
