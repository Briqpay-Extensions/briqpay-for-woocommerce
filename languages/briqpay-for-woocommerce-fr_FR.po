msgstr "Afficher les lignes de commande au-dessus de la section de paiement"

#: includes/class-gateway.php:173
msgid "Logging"
msgstr "Journalisation"

#: includes/class-gateway.php:174
msgid "Log Briqpay events"
msgstr "Journaliser les événements Briqpay"

#: includes/class-gateway.php:176
msgid "Log Briqpay events, such as API requests."
msgstr "Journaliser les événements Briqpay, par exemple les requêtes API."

#: includes/class-gateway.php:180
msgid "Verbose Logging"
msgstr "Journalisation détaillée"

#: includes/class-gateway.php:181
msgid "Enable verbose debug logs"
msgstr "Activer les journaux de débogage détaillés"

#: includes/class-gateway.php:183
