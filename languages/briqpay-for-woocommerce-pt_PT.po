msgstr "Briqpay"

#: includes/class-gateway.php:42
msgid "Briqpay streamlines all payment methods into one integration."
msgstr "A Briqpay reúne todos os métodos de pagamento numa única integração."

#: includes/class-gateway.php:79
msgid "Enable/Disable"
msgstr "Ativar/Desativar"

#: includes/class-gateway.php:81
msgid "Enable Briqpay"
msgstr "Ativar a Briqpay"

